# UdaPlanner Environment Configuration
# Salin file ini menjadi .env.local dan isi dengan konfigurasi proyek Supabase Anda.

# Supabase URL (Didapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Aman digunakan di browser frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Hanya untuk server/backend rahasia, JANGAN diekspos ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mode Demo / Mock Offline (true jika ingin menggunakan penyimpanan lokal dan mempermudah pengujian tanpa Supabase langsung)
NEXT_PUBLIC_DEMO_MODE=false

# Domain Aplikasi Produksi (Vercel)
# Digunakan untuk tautan verifikasi email, reset kata sandi, dan undangan kolaborasi tim.
# Di Vercel, atur environment variable ini sesuai domain deployment Anda:
# NEXT_PUBLIC_SITE_URL=https://nama-proyek-anda.vercel.app
NEXT_PUBLIC_SITE_URL=https://uda-planner.vercel.app
